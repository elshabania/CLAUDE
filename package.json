{
  "name": "masterplan-highway-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Extract the highway network from a masterplan PDF, estimate its dimensions, and grade HCM Level of Service.",
  "author": "Masterplan Highway Analyzer",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:wasm": "bash native/build.sh",
    "test:wasm": "node native/test.mjs",
    "electron:dev": "next build && electron .",
    "dist:win": "next build && electron-builder --win --publish never",
    "dist:dir": "next build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@types/three": "^0.184.1",
    "dxf-parser": "^1.1.2",
    "next": "^16.2.6",
    "pdfjs-dist": "^4.10.38",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.masterplan.highwayanalyzer",
    "productName": "Masterplan Highway Analyzer",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
