# Serve fixture JSON from src/mock/fixtures instead of calling the backend.
VITE_USE_MOCK=0
# MapLibre style URL for a self-hosted basemap (e.g. a PMTiles-backed style.json).
# Leave empty to use the built-in blank neutral style (no network calls).
VITE_BASEMAP_STYLE_URL=
# API base path (the Vite dev server proxies /api to http://localhost:8000).
VITE_API_BASE=/api/v1
